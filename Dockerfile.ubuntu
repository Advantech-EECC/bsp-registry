ARG DISTRO="ubuntu:20.04"

FROM ${DISTRO}

USER root

ARG DISTRO
ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=en_US.utf8

RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 locales && \
    localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8 

RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 \
    python3 python3-pip python3-venv python3-virtualenv python3-pexpect \
    xz-utils debianutils iputils-ping python3-git python3-jinja2 libegl1 libsdl1.2-dev libgnutls28-dev \
    pylint python3-setuptools python3-wheel python3-yaml python3-distro python3-jsonschema python3-newt \
    chrpath cpio diffstat gawk lz4 wget zstd git-lfs \
    zip \
    file \
    bash-completion 

# kas 5.4 requires Python 3.9 or newer; Ubuntu 20.04 ships Python 3.8.
RUN if [ "${DISTRO}" = "ubuntu:20.04" ]; then \
        apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 python3.9 && \
    test -x /usr/bin/python3.9; \
    else \
        KAS_PYTHON=/usr/bin/python3; \
    fi

# add iproute2 for qemu network support
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 iproute2 

# original kas image doesn't have gfortran installed for some reason
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 gfortran efitools

# meta-updater dependencies
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 cpu-checker default-jre

# add parted for wic
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 parted mtools

# additional packages
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 gosu binfmt-support

# add crypto++
RUN apt-get update -o Acquire::Retries=3 && \
    apt-get install -y -o Acquire::Retries=3 libcrypto++-dev libssl-dev libffi-dev

# Ubuntu's CVE-2025-45582 backport makes tar extract through openat2(), a raw
# syscall pseudo cannot intercept, breaking do_package with
# "unknown base path for fd N" / "Cannot mkdir: Bad address".
# Pin the pre-backport release-pocket build on affected distros.
ARG TAR_VERSION=""
RUN if [ -n "${TAR_VERSION}" ]; then \
        apt-get update -o Acquire::Retries=3 && \
        apt-get install -y -o Acquire::Retries=3 --allow-downgrades "tar=${TAR_VERSION}" && \
        apt-mark hold tar; \
    fi

RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ARG KAS_VERSION=5.4

RUN if [ "${DISTRO}" = "ubuntu:20.04" ]; then \
    KAS_PYTHON=/usr/bin/python3.9; \
    else \
        KAS_PYTHON=/usr/bin/python3; \
    fi && \
    test -x "${KAS_PYTHON}" && \
    virtualenv --python="${KAS_PYTHON}" /opt/kas-venv && \
    /opt/kas-venv/bin/pip install --upgrade pip && \
    /opt/kas-venv/bin/pip install "kas==${KAS_VERSION:?}" awscli

ENV PATH="/opt/kas-venv/bin:${PATH}"

RUN groupadd builder -g 30000 && \
    useradd builder -u 30000 -g 30000 --create-home --home-dir /builder && \
    usermod -aG sudo builder 

RUN /bin/bash -c "echo \"PS1='${debian_chroot:+($debian_chroot)}\[\033[01;31m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '\" >> /builder/.bashrc "    

USER builder

COPY scripts/kas/container-entrypoint /container-entrypoint

ENTRYPOINT ["/container-entrypoint"]
